<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/SectionHeader" android:text="Permissions" />
        <TextView android:id="@+id/shizukuStatus" style="@style/StatusLine" />
        <Button android:id="@+id/btnShizuku" style="@style/Row" android:text="Grant Shizuku access" />
        <TextView android:id="@+id/overlayStatus" style="@style/StatusLine" />
        <Button android:id="@+id/btnOverlay" style="@style/Row" android:text="Allow drawing over other apps" />
        <TextView android:id="@+id/notifStatus" style="@style/StatusLine" />
        <Button android:id="@+id/btnNotif" style="@style/Row" android:text="Allow notifications" />

        <TextView style="@style/SectionHeader" android:text="Settings" />
        <TextView style="@style/StatusLine" android:text="Screen for the pad" />
        <Spinner android:id="@+id/displaySpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Switch android:id="@+id/bootSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Start in the background at boot" />

        <TextView style="@style/SectionHeader" android:text="Run" />
        <TextView android:id="@+id/serviceStatus" style="@style/StatusLine" />
        <Button android:id="@+id/btnStart" style="@style/Row" android:text="Start SidePad" />
        <Button android:id="@+id/btnGuide" style="@style/Row" android:text="Show the gesture guide on the pad's screen" />
    </LinearLayout>
</ScrollView>
